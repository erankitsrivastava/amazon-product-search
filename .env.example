# ============================================================
# Amazon Affiliate Social Publisher — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- App Login (single user) --------------------------------
APP_USERNAME=admin
APP_PASSWORD=yourpassword
SESSION_SECRET=change_this_to_a_random_string

# --- Server -------------------------------------------------
PORT=3000

# --- Amazon SiteStripe Affiliate API ------------------------
# Your Amazon Associates store ID
AMAZON_STORE_ID=kikikart-21
# Marketplace ID (44571 = amazon.in)
AMAZON_MARKETPLACE_ID=44571
# Full cookie string from your Amazon Associates session
# (copy from the curl command you use with the SiteStripe API)
AMAZON_COOKIES=csm-sid=...; session-id=...; ...

# --- Custom URL Shortener (url.haxcode.com) -----------------
URL_SHORTENER_TOKEN=haWsREkFeczlJBuzCuwRpNCmVvKHEHQy
URL_SHORTENER_BASE=https://url.haxcode.com

# --- Instagram / Facebook -----------------------------------
# HOW TO GET THESE:
# 1. Go to https://developers.facebook.com and create an App
# 2. Add "Instagram Graph API" product to your app
# 3. Connect your Instagram Business Account to a Facebook Page
# 4. Generate a Page Access Token via Graph API Explorer
#    (request: instagram_basic, instagram_content_publish, pages_read_engagement)
# 5. Exchange for long-lived token (valid 60 days):
#    GET https://graph.facebook.com/oauth/access_token
#      ?grant_type=fb_exchange_token
#      &client_id={app_id}
#      &client_secret={app_secret}
#      &fb_exchange_token={short_lived_token}
# 6. Get Instagram Business Account ID:
#    GET https://graph.facebook.com/me/accounts (to find page_id)
#    GET https://graph.facebook.com/{page_id}?fields=instagram_business_account
FB_PAGE_ACCESS_TOKEN=
FB_INSTAGRAM_ACCOUNT_ID=
FB_PAGE_ID=

# --- Pinterest ----------------------------------------------
# HOW TO GET THESE:
# 1. Go to https://developers.pinterest.com and create an App
# 2. Request "Standard access" for pins:write and boards:read scopes
# 3. Complete OAuth flow to get an access token
# 4. Find your Board ID:
#    GET https://api.pinterest.com/v5/boards (Authorization: Bearer <token>)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
